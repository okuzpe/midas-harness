# Secrets — never commit (.env.example is OK to commit)
.env
.env.*
!.env.example
*.pem
*.key
*secret*
*credential*
.claude/settings.local.json

# Dependencies & build output (npx, local tooling, common stacks)
node_modules/
vendor/
dist/
build/
out/
.next/
.turbo/
__pycache__/
*.py[cod]
.venv/
venv/
target/
*.log

# Midas volatile state (state.yaml IS committed; caches/hashes are not)
.harness/cache/
.harness/*.hash
.midas/cache/
.midas/*.hash
