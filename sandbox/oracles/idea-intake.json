{
  "skill": "idea-intake",
  "checks": [
    { "id": "idea-file", "type": "file_exists", "path": "{product}/idea.md" },
    { "id": "raw-heading", "type": "file_contains", "path": "{product}/idea.md", "pattern": "## Raw idea (preserved verbatim)" },
    { "id": "pitch-heading", "type": "file_contains", "path": "{product}/idea.md", "pattern": "## 1-line pitch" },
    { "id": "pitch-not-todo", "type": "file_not_contains", "path": "{product}/idea.md", "pattern": "<!-- TODO: one sentence" },
    { "id": "raw-not-todo", "type": "file_not_contains", "path": "{product}/idea.md", "pattern": "<!-- TODO: paste or transcribe" },
    { "id": "mode-heading", "type": "file_contains", "path": "{product}/idea.md", "pattern": "## Mode" },
    { "id": "mode-state", "type": "state_match", "field": "mode", "value": "greenfield" },
    { "id": "gate-passed", "type": "state_match", "field": "phases.idea_intake.gate", "value": "passed" },
    { "id": "phase-passed", "type": "state_match", "field": "phases.idea_intake.status", "value": "passed" },
    { "id": "stage-advanced", "type": "state_match", "field": "stage", "value": "contextualize" },
    { "id": "idea-artifact", "type": "state_list_contains", "field": "phases.idea_intake.artifacts", "value": "{product}/idea.md" },
    { "id": "updated-not-seed", "type": "fixture_field_changed", "field": "updated" },
    { "id": "state-not-seed", "type": "fixture_file_changed", "path": "{state}" },
    { "id": "gate-record", "type": "file_exists", "path": "{runs}/audits/gate-00.md" },
    { "id": "gate-record-verdict", "type": "file_contains", "path": "{runs}/audits/gate-00.md", "pattern": "MIDAS_GATE_RESULT: verdict=pass" }
  ]
}
