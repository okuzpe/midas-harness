{
  "skill": "contextualize",
  "checks": [
    { "id": "idea-file", "type": "file_exists", "path": "{product}/idea.md" },
    { "id": "raw-intact", "type": "file_contains", "path": "{product}/idea.md", "pattern": "## Raw idea (preserved verbatim)" },
    { "id": "contextualized-heading", "type": "file_contains", "path": "{product}/idea.md", "pattern": "## Contextualized" },
    { "id": "open-questions", "type": "file_exists", "path": "{product}/open-questions.md" },
    { "id": "gate-passed", "type": "state_match", "field": "phases.contextualize.gate", "value": "passed" },
    { "id": "phase-passed", "type": "state_match", "field": "phases.contextualize.status", "value": "passed" },
    { "id": "stage-advanced", "type": "state_match", "field": "stage", "value": "market_research" },
    { "id": "open-q-artifact", "type": "state_list_contains", "field": "phases.contextualize.artifacts", "value": "{product}/open-questions.md" },
    { "id": "updated-not-seed", "type": "fixture_field_changed", "field": "updated" },
    { "id": "state-not-seed", "type": "fixture_file_changed", "path": "{state}" },
    { "id": "gate-record", "type": "file_exists", "path": "{runs}/audits/gate-01.md" },
    { "id": "gate-record-verdict", "type": "file_contains", "path": "{runs}/audits/gate-01.md", "pattern": "MIDAS_GATE_RESULT: verdict=pass" }
  ]
}
