# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*secret*
*credential*
.claude/settings.local.json

# Node
node_modules/
npm-debug.log*

# Midas volatile state (harness/state.yaml IS committed; caches/hashes are not)
.harness/cache/
.harness/*.hash
**/.DS_Store
Thumbs.db

# midas:begin GITIGNORE — installed by create-midas; extend with your own patterns below

# midas: amend — patterns added on install/update
vendor/
dist/
build/
out/
.next/
.turbo/
__pycache__/
*.py[cod]
.venv/
venv/
target/
*.log

# midas: amend — patterns added on install/update
.midas/cache/
.midas/*.hash

# midas: amend — patterns added on install/update
coverage/
test-results/
playwright-report/
blob-report/
status.html
*.midas-bundle.json

# midas: amend — patterns added on install/update
.harness/migrations/backups/

# midas: amend — patterns added on install/update
.harness/runs/explore/.active
.harness/explore/.active
.midas/explore/.active
# midas:end

# MkDocs build output (CI uses _site/; default `mkdocs build` writes site/ — both ignored)
site/
_site/

# npm pack / local publish artifacts
*.tgz

# Engine repo: cursor-only mirror noise (multi-host dogfood uses .claude/skills + .agents/skills)
/.cursor/skills/
