# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*secret*
*credential*
!harness/autonomy/lib/credentials.mjs
!cli/template/.optional/autonomy/lib/credentials.mjs
!scripts/safety/secrets-prompt.mjs
!scripts/safety/tests/secrets-prompt.test.js
!cli/template/.harness/scripts/safety/secrets-prompt.mjs
.claude/settings.local.json

# Node
node_modules/
npm-debug.log*

# Midas volatile state (harness/state.yaml IS committed; caches/hashes are not)
.harness/cache/
.harness/*.hash
runs/cache/
runs/*.hash

# Muninn-adapt session/metrics/installer (under cache — already covered by .harness/cache/ and runs/cache/)
#   session/commit-approved.json
#   metrics/current-carryover.json
#   metrics/context-cost.jsonl | lifecycle.jsonl | context-cost.log
#   context/digest.json
#   installer/runs/ | active.json | install.lock
# Belt: if written outside cache (misconfigured path)
runs/session/
runs/metrics/
runs/installer/

**/.DS_Store
Thumbs.db

# midas:begin GITIGNORE — installed by create-midas; extend with your own patterns below

# midas: amend — patterns added on install/update
vendor/
dist/
build/
out/
.next/
.turbo/
__pycache__/
*.py[cod]
.venv/
venv/
target/
*.log

# midas: amend — patterns added on install/update
.midas/cache/
.midas/*.hash

# midas: amend — patterns added on install/update
coverage/
test-results/
playwright-report/
blob-report/
status.html
*.midas-bundle.json

# midas: amend — patterns added on install/update
.harness/migrations/backups/

# midas: amend — patterns added on install/update
.harness/runs/explore/.active
.harness/explore/.active
.midas/explore/.active

# midas: amend — patterns added on install/update
!**/.harness/autonomy/lib/credentials.mjs
.harness/autonomy/authz/
# midas:end

# MkDocs build output (CI uses _site/; default `mkdocs build` writes site/ — both ignored)
site/
_site/

# npm pack / local publish artifacts
*.tgz

# Engine repo: cursor-only mirror noise (multi-host adapter coverage uses .claude/skills + .agents/skills)
/.cursor/skills/

# Local analysis artifacts (not part of the repo)
docs/analisis/

# Accidental temp dirs created inside the repo (installer lock tests, etc.)
*midas-lock-test*/
