{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node scripts/trace-hook.mjs sessionStart",
        "timeout": 10
      },
      {
        "command": "node scripts/carryover-refresh.mjs --hook",
        "timeout": 10
      },
      {
        "command": "node scripts/context-cost-refresh.mjs --hook",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node scripts/trace-hook.mjs postToolUse",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "node scripts/trace-hook.mjs subagentStop",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node scripts/trace-hook.mjs stop",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node scripts/safety/secrets-prompt.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node scripts/safety/gate-commits.mjs",
        "timeout": 10,
        "failClosed": true
      },
      {
        "command": "node scripts/safety/destructive-shell.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
