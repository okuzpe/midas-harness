# Secrets — never commit (.env.example is OK to commit)
.env
.env.*
!.env.example
*.pem
*.key
*secret*
*credential*
!**/.harness/autonomy/lib/credentials.mjs
.claude/settings.local.json

# Dependencies & build output (npx, local tooling, common stacks)
node_modules/
vendor/
dist/
build/
out/
.next/
.turbo/
__pycache__/
*.py[cod]
.venv/
venv/
target/
*.log

# Test / browser tooling (midas-verify, midas-qa, CI)
coverage/
test-results/
playwright-report/
blob-report/

# Midas local tooling output (not frozen evidence)
status.html
*.midas-bundle.json

# Midas volatile state (state.yaml IS committed; caches/hashes are not)
.harness/cache/
# Muninn-adapt under cache (covered by .harness/cache/): session/commit-approved.json,
# metrics/current-carryover.json, metrics/context-cost.jsonl, metrics/lifecycle.jsonl, installer/runs/
.harness/migrations/backups/
.harness/*.hash
.harness/runs/explore/.active
.harness/explore/.active
.harness/autonomy/authz/
.midas/cache/
.midas/*.hash
.midas/explore/.active

# midas:kit-begin — product installs only (engine repo skips this block)
# Vendor kit + generated adapters: restored by `midas update`. Do not commit them.
# Keep project memory: state.yaml, product/, rules/, runs/, autonomy user files.
# AGENTS.md and .mcp.json stay tracked (project law / user MCP).
# .claude/skills and .agents/skills mix vendor mirrors with project skills — merge injects
# one ignore per engine slug (`.claude/skills/<slug>/`), never the whole tree.
.harness/*
!.harness/state.yaml
!.harness/product/
!.harness/product/**
!.harness/rules/
!.harness/rules/**
!.harness/runs/
!.harness/runs/**
!.harness/autonomy/
.harness/autonomy/**
!.harness/autonomy/policy.yaml
!.harness/autonomy/control.json
!.harness/autonomy/budget-ledger.json
!.harness/autonomy/journal-anchor.json
.harness/runs/explore/.active
.claude/agents/
.claude/CLAUDE.md
.cursor/skills/
.cursor/rules/00-midas.mdc
.cursor/rules/01-midas-checks.mdc
.cursor/mcp.json
GEMINI.md
.harness/.windsurf/
.windsurf/rules/00-midas.md
.windsurf/rules/01-midas-checks.md
# midas:kit-end
